{
  "name": "@zerodrift/payments",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@zerodrift/common": "workspace:*",
    "@zerodrift/config": "workspace:*",
    "@zerodrift/db": "workspace:*",
    "@zerodrift/events": "workspace:*",
    "@zerodrift/money": "workspace:*",
    "kysely": "^0.29.7",
    "opossum": "^10.0.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.23.1",
    "@zerodrift/ledger": "workspace:*",
    "@zerodrift/mock-gateway": "workspace:*",
    "@zerodrift/testing": "workspace:*",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": "./dist/main.js",
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./package.json": "./package.json"
