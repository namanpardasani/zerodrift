{
  "name": "@zerodrift/mock-gateway",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@zerodrift/common": "workspace:*",
    "@zerodrift/config": "workspace:*",
    "@zerodrift/db": "workspace:*",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@zerodrift/telemetry": "workspace:*"
  },
  "exports": {
    ".": "./dist/main.js",
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "vitest": "^5.0.5",
    "@zerodrift/testing": "workspace:*"
  }
}
