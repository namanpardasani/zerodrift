{
  "name": "zerodrift",
  "private": true,
  "version": "0.1.0",
  "description": "Double-entry payments ledger with idempotent APIs and Kafka sagas",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "migrate": "pnpm -r --if-present migrate",
    "e2e:smoke": "e2e/run.sh",
    "audit:deps": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
