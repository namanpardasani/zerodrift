# Copy to .env and fill in (never commit .env). Used by:
#   docker compose -f deploy/compose/docker-compose.prod.yml --env-file .env up -d
# Every value marked REQUIRED must be a real secret: in production the services refuse development defaults and stop at start-up.
# Generate secrets with openssl (shown next to each). Full reference of every variable of every service: docs/ENVIRONMENT.md

# ---- where the images are (built by deploy/build-images.sh)
REGISTRY=            # e.g. ghcr.io/your-user/   (empty = images built locally on this host)
TAG=latest

# ---- public hostnames (DNS A records pointing at this host; Caddy gets certificates for them automatically)
CONSOLE_HOST=console.example.com   # landing page + operator console
SHOP_HOST=shop.example.com         # demo storefront (demo only)
API_HOST=api.example.com           # merchant API
# HTTP_PORT=80
# HTTPS_PORT=443

# ---- secrets (REQUIRED)
POSTGRES_PASSWORD=                 # openssl rand -base64 24
ADMIN_TOKEN=                       # openssl rand -hex 24   (service-to-service admin calls; also what the console BFF uses)
GATEWAY_CALLBACK_SECRET=           # openssl rand -hex 24   (signs the bank's async callbacks)
WEBHOOK_ENCRYPTION_KEY=            # openssl rand -base64 32  (exactly 32 bytes; encrypts webhook signing secrets at rest)
JWT_SECRET=                        # openssl rand -base64 48  (operator console sessions, >= 32 chars)
DASHBOARD_PASSWORD=                # the operator password for the console (choose a long one)

# ---- optional
# POSTGRES_USER=zerodrift
# DASHBOARD_USER=admin
# LOG_LEVEL=info
# KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
# ALLOW_PRIVATE_WEBHOOK_URLS=false  # leave false in production (SSRF guard)
